---
import { baseUrl } from '../utils/base.ts';

export interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  switchHref?: string;
}

const { title, description = 'UOMP — Agent 记忆同意协议', lang = 'zh', switchHref } = Astro.props;

const nav = {
  zh: {
    home: '首页',
    spec: '规范',
    design: '参考实现',
    tutorial: '教程',
    example: '试用',
    roadmap: '路线图',
    github: 'GitHub',
    switch: 'EN',
    brand: 'UOMP',
    brandParent: 'Aegis OS module',
    brandTagline: 'Aegis OS 的记忆同意协议',
    aegis: 'Aegis OS',
    footerCols: {
      protocol: { title: '协议', links: [{ t: '规范', h: `${baseUrl}spec/` }, { t: '实现设计', h: `${baseUrl}design/` }, { t: '路线图', h: `${baseUrl}roadmap/` }] },
      implementation: { title: '实现', links: [{ t: 'Aegis OS 参考实现', h: 'https://heurion.org/#aegis-os' }, { t: '参考 CLI 教程', h: `${baseUrl}tutorial/` }, { t: 'GitHub', h: 'https://github.com/0xSynapse/uomp-core' }, { t: 'Issues', h: 'https://github.com/0xSynapse/uomp-core/issues' }] },
    },
    footerNote: 'UOMP 是 Aegis OS 的协议模块，由 Heurion Research 维护。',
    footerBtm: '© UOMP contributors · Aegis OS module · Heurion Research · Apache 2.0',
  },
  en: {
    home: 'Home',
    spec: 'Spec',
    design: 'Reference',
    tutorial: 'Tutorial',
    example: 'Try',
    roadmap: 'Roadmap',
    github: 'GitHub',
    switch: '中文',
    brand: 'UOMP',
    brandParent: 'Aegis OS module',
    brandTagline: 'The memory consent protocol of Aegis OS',
    aegis: 'Aegis OS',
    footerCols: {
      protocol: { title: 'Protocol', links: [{ t: 'Spec', h: `${baseUrl}en/spec/` }, { t: 'Implementation', h: `${baseUrl}en/design/` }, { t: 'Roadmap', h: `${baseUrl}en/roadmap/` }] },
      implementation: { title: 'Implementation', links: [{ t: 'Aegis OS reference runtime', h: 'https://heurion.org/#aegis-os' }, { t: 'Reference CLI tutorial', h: `${baseUrl}en/tutorial/` }, { t: 'GitHub', h: 'https://github.com/0xSynapse/uomp-core' }, { t: 'Issues', h: 'https://github.com/0xSynapse/uomp-core/issues' }] },
    },
    footerNote: 'UOMP is a protocol module of Aegis OS, maintained by Heurion Research.',
    footerBtm: '© UOMP contributors · Aegis OS module · Heurion Research · Apache 2.0',
  },
};

const t = nav[lang];
const homeHref = lang === 'zh' ? baseUrl : `${baseUrl}en/`;
const specHref = lang === 'zh' ? `${baseUrl}spec/` : `${baseUrl}en/spec/`;
const designHref = lang === 'zh' ? `${baseUrl}design/` : `${baseUrl}en/design/`;
const tutorialHref = lang === 'zh' ? `${baseUrl}tutorial/` : `${baseUrl}en/tutorial/`;
const tryHref = lang === 'zh' ? `${baseUrl}try/` : `${baseUrl}en/try/`;
const roadmapHref = lang === 'zh' ? `${baseUrl}roadmap/` : `${baseUrl}en/roadmap/`;
const resolvedSwitchHref = switchHref ?? (lang === 'zh' ? `${baseUrl}en/` : baseUrl);

const pathname = Astro.url.pathname;
const isHome = pathname === baseUrl || pathname === `${baseUrl}en/` || pathname === `${baseUrl}index.html`;
const isSpec = pathname.startsWith(`${baseUrl}spec/`) || pathname.startsWith(`${baseUrl}en/spec/`);
const isDesign = pathname.startsWith(`${baseUrl}design/`) || pathname.startsWith(`${baseUrl}en/design/`);
const isTutorial = pathname.startsWith(`${baseUrl}tutorial/`) || pathname.startsWith(`${baseUrl}en/tutorial/`);
const isTry = pathname.startsWith(`${baseUrl}try/`) || pathname.startsWith(`${baseUrl}en/try/`);
const isRoadmap = pathname.startsWith(`${baseUrl}roadmap/`) || pathname.startsWith(`${baseUrl}en/roadmap/`);
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="UOMP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- hreflang -->
    <link rel="canonical" href={Astro.url.href.replace(/\/$/, '') + '/'} />
    {lang === 'zh' ? (
      <link rel="alternate" hreflang="en" href={switchHref || `${baseUrl}en/`} />
    ) : (
      <link rel="alternate" hreflang="zh-CN" href={switchHref || baseUrl} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${baseUrl}styles/global.css`} />
  </head>
  <body>
    <div class="nav-outer">
      <nav>
        <a href={homeHref} class="nav-logo" aria-label={t.brand}>
          <svg class="nav-mark" viewBox="0 0 28 22" fill="none" aria-hidden="true">
            <path d="M10 1H1v20h9" stroke="currentColor" stroke-width="1.2"/>
            <path d="M18 1h9v20h-9" stroke="currentColor" stroke-width="1.2"/>
            <line x1="10" y1="11" x2="18" y2="11" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="14" cy="11" r="1.7" fill="var(--heurion-mint)"/>
          </svg>
          <span class="nav-word">{t.brand}</span>
          <span class="nav-parent">{t.brandParent}</span>
        </a>
        <ul class="nav-links">
          <li><a href={homeHref} class={isHome ? 'active' : ''}>{t.home}</a></li>
          <li><a href={specHref} class={isSpec ? 'active' : ''}>{t.spec}</a></li>
          <li><a href={designHref} class={isDesign ? 'active' : ''}>{t.design}</a></li>
          <li><a href={tutorialHref} class={isTutorial ? 'active' : ''}>{t.tutorial}</a></li>
          <li><a href={tryHref} class={isTry ? 'active' : ''}>{t.example}</a></li>
          <li><a href={roadmapHref} class={isRoadmap ? 'active' : ''}>{t.roadmap}</a></li>
        </ul>
        <div class="nav-r">
          <button class="nav-hamburger" id="hamburger" aria-label="Menu" style="display:none">
            <span></span>
          </button>
          <a href={resolvedSwitchHref} class="btn-ng">{t.switch}</a>
          <a href="https://heurion.org/#aegis-os" target="_blank" rel="noopener" class="btn-np">{t.aegis}</a>
        </div>
      </nav>
    </div>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-top">
        <div class="footer-brand">
          <a href={homeHref} class="footer-logo">
            <svg class="footer-mark" viewBox="0 0 28 22" fill="none" aria-hidden="true">
              <path d="M10 1H1v20h9" stroke="currentColor" stroke-width="1.2"/>
              <path d="M18 1h9v20h-9" stroke="currentColor" stroke-width="1.2"/>
              <line x1="10" y1="11" x2="18" y2="11" stroke="currentColor" stroke-width="1.2"/>
              <circle cx="14" cy="11" r="1.7" fill="var(--heurion-mint)"/>
            </svg>
            <span>{t.brand}</span>
          </a>
          <p>{t.brandTagline}</p>
          <p class="footer-note">{t.footerNote}</p>
        </div>
        <div class="footer-col">
          <h4>{t.footerCols.protocol.title}</h4>
          <ul>
            {t.footerCols.protocol.links.map(l => (
              <li><a href={l.h} target={l.h.startsWith('http') ? '_blank' : undefined} rel={l.h.startsWith('http') ? 'noopener' : undefined}>{l.t}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t.footerCols.implementation.title}</h4>
          <ul>
            {t.footerCols.implementation.links.map(l => (
              <li><a href={l.h} target={l.h.startsWith('http') ? '_blank' : undefined} rel={l.h.startsWith('http') ? 'noopener' : undefined}>{l.t}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer-btm">
        <span>{t.footerBtm}</span>
        <a href="https://heurion.org" target="_blank" rel="noopener">Heurion Research ↗</a>
      </div>
    </footer>
    <script>
      const btn = document.getElementById('hamburger');
      const links = document.querySelector('.nav-links');
      if (btn && links) {
        if (window.innerWidth <= 768) btn.style.display = 'flex';
        window.addEventListener('resize', () => {
          btn.style.display = window.innerWidth <= 768 ? 'flex' : 'none';
          if (window.innerWidth > 768) links.classList.remove('open');
        });
        btn.addEventListener('click', () => links.classList.toggle('open'));
      }
    </script>
  </body>
</html>
