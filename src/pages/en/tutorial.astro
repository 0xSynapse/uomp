---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { baseUrl } from '../../utils/base.ts';

const tutorials = await getCollection('tutorial');
const t = tutorials.find(t => t.slug === 'tutorialen');
const { Content } = t ? await t.render() : { Content: null };
---

<Layout
  title="User Guide - UOMP"
  description="Install UOMP, import notes, authorize Claude Desktop / Cursor, audit reads, and revoke access"
  lang="en"
  switchHref={`${baseUrl}tutorial/`}
>
  <section>
    <div class="container">
      <div class="sec-eyebrow">
        <div class="sec-num">Guide</div>
        <span class="sec-tag">Get started</span>
      </div>
      <div class="spec-content">
        {Content && <Content />}
      </div>
      <div class="hero-btns" style="margin-top: 2.5rem;">
        <a href={`${baseUrl}en/spec/`} class="btn-h1">Specification →</a>
        <a href={`${baseUrl}en/design/`} class="btn-h1">Implementation →</a>
        <a href="https://github.com/heurion-org/aegis-os" target="_blank" rel="noopener" class="btn-h2">GitHub</a>
      </div>
    </div>
  </section>
</Layout>
