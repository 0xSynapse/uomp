---
import Layout from '../layouts/Layout.astro';
import { baseUrl } from '../utils/base.ts';
---

<Layout title="试用 - UOMP" description="今天可以用 CLI 跑通 UOMP 的授权闭环；MCP 客户端和浏览器授权界面是下一个里程碑。" switchHref={`${baseUrl}en/try/`}>
  <section>
    <div class="container">
      <h1 style="margin-bottom:.25rem">试用 UOMP</h1>
      <p style="color:var(--mid);max-width:620px;line-height:1.65">
        今天，授权闭环通过 CLI 跑通：导入 Markdown 笔记、授权一个有范围限制的会话、审计并撤销。
        MCP 客户端和浏览器授权界面是下一个里程碑。
        两者共享 <code style="font-size:.88rem">@uomp/sdk</code>、Token 体系、Guard 鉴权和审计日志。
      </p>
    </div>

    <div class="container" style="margin-top:2.5rem">
      <div style="display:flex;gap:2rem;flex-wrap:wrap">

        <!-- MCP Card -->
        <div class="card" style="flex:1;min-width:320px;order:2">
          <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem">
            <span style="font-size:2rem">🔌</span>
            <h2 style="margin:0;font-size:1.35rem">MCP 客户端</h2>
          </div>
          <p style="color:var(--mid);margin-bottom:.75rem;max-width:420px">
            下一个里程碑。Claude Desktop、Cursor 或任何 MCP 客户端请求访问本地目录的一个范围，你在浏览器里批准。
          </p>
          <div style="background:var(--violet-bg);border:1px solid var(--border);border-radius:8px;padding:.75rem 1rem;margin-bottom:1.25rem;font-size:.8rem;color:var(--violet)">
            <strong>开发中。</strong>尚未可用——关注路线图，等待第一个设计伙伴版本。
          </div>
          <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.25rem">
            <div style="font-size:.8rem;color:var(--mid);margin-bottom:.4rem;font-weight:600">目标流程</div>
            <div style="font-size:.85rem;color:var(--mid);line-height:1.8">
              1. 把 UOMP 指向一个 Obsidian 笔记库或 Markdown 目录<br/>
              2. Agent 请求读取 <code>notes/projects/**</code>，30 分钟<br/>
              3. 你在浏览器里批准范围和时长<br/>
              4. 每次读取都被检查和记录<br/>
              5. 撤销——下一个请求返回 <code>403</code>
            </div>
          </div>
          <a href={`${baseUrl}roadmap/`} style="display:inline-flex;align-items:center;gap:.4rem;padding:.65rem 1.5rem;background:#7C3AED;border-radius:8px;color:#fff;text-decoration:none;font-weight:600;font-size:.9rem">
            查看路线图 →
          </a>
        </div>

        <!-- CLI Card -->
        <div class="card" style="flex:1;min-width:320px;order:1;border-color:var(--violet);border-width:2px">
          <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem">
            <span style="font-size:2rem">⌨️</span>
            <h2 style="margin:0;font-size:1.35rem">通过 CLI 试用</h2>
          </div>
          <p style="color:var(--mid);margin-bottom:1.25rem;max-width:400px">
            今天就能用。导入 Obsidian/Markdown 笔记，给本地 Agent 签发一个有时限、可撤销的会话。
          </p>
          <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:.75rem">
            <div style="font-size:.8rem;color:var(--mid);margin-bottom:.4rem;font-weight:600">命令速览</div>
            <pre style="font-size:.8rem;color:var(--mid);line-height:1.75;overflow-x:auto;background:transparent;margin:0"><code>pnpm cli init
pnpm cli import ~/Obsidian/MyVault
pnpm cli authorize ./agent --scope notes/projects
pnpm cli sessions
pnpm cli revoke &lt;id&gt;</code></pre>
          </div>
          <p style="color:var(--mid);font-size:.82rem;line-height:1.6;margin-bottom:1.25rem">
            <code>authorize</code> 会把 token 写入 <code>~/.uomp/sessions/&lt;id&gt;.env</code>（0600），
            默认不打印 JWT。在另一个终端 <code>source</code> 后运行 Agent。
          </p>
          <a href={`${baseUrl}tutorial/`} style="display:inline-flex;align-items:center;gap:.4rem;padding:.65rem 1.5rem;background:#2563EB;border-radius:8px;color:#fff;text-decoration:none;font-weight:600;font-size:.9rem">
            CLI 教程 →
          </a>
        </div>
      </div>
    </div>

    <!-- Shared infrastructure -->
    <div class="container" style="margin-top:3.5rem">
      <div class="card" style="max-width:760px">
        <h2 style="font-size:1.15rem;margin-bottom:.75rem">共享基础设施</h2>
        <p style="color:var(--mid);font-size:.88rem;line-height:1.7">
          CLI 和 MCP 是 <strong>同一套实现的两种交互界面</strong>。底层共享 <code>@uomp/sdk</code>、<code>@uomp/core</code>、Capability Token 体系、Guard 鉴权和审计日志。区别仅在于：今天在终端里用 CLI 驱动 Agent；下一步，MCP 客户端无需定制代码即可接入。
        </p>
      </div>
    </div>

    <!-- SDK Quick Reference -->
    <div class="container" style="margin-top:3.5rem">
      <h2 style="font-size:1.15rem;margin-bottom:.5rem">构建你自己的 Agent</h2>
      <p style="color:var(--mid);margin-bottom:1.5rem">如果你是 Agent 开发者，通过 <code>@uomp/sdk</code> 接入：</p>
      <div class="table-wrap">
      <table>
        <tr><th>子客户端</th><th>方法</th><th>说明</th></tr>
        <tr><td><code>uomp.memory</code></td><td><code>get</code>, <code>getByTag</code>, <code>getByKeys</code></td><td>读取用户数据</td></tr>
        <tr><td><code>uomp.memory</code></td><td><code>set</code>, <code>delete</code></td><td>写入（需授权）</td></tr>
        <tr><td><code>uomp.aggregate</code></td><td><code>sum</code>, <code>avg</code>, <code>count</code>, <code>min</code>, <code>max</code></td><td>聚合查询</td></tr>
        <tr><td><code>uomp.payload</code></td><td><code>upload</code>, <code>download</code></td><td>上传/下载报告</td></tr>
        <tr><td><code>uomp.session</code></td><td><code>submitDeletionProof</code>, <code>finalize</code></td><td>删除证明 + 关闭会话</td></tr>
        <tr><td><code>uomp.auth</code></td><td><code>createSession</code>, <code>grant</code>, <code>revoke</code></td><td>Session 管理</td></tr>
        <tr><td><code>uomp.audit</code></td><td><code>query</code></td><td>审计日志</td></tr>
      </table>
      </div>
    </div>

    <div class="hero-btns" style="margin-top:3rem">
      <a href="https://github.com/0xSynapse/uomp-core/tree/main/examples/stock-analyst" target="_blank" rel="noopener" class="btn-h1" style="background:#059669">股票分析 Agent 源码 →</a>
      <a href={`${baseUrl}tutorial/`} class="btn-h1">SDK 教程 →</a>
      <a href="https://github.com/0xSynapse/uomp-core" target="_blank" rel="noopener" class="btn-h2">GitHub</a>
    </div>
  </section>
</Layout>
