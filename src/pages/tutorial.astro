---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { baseUrl } from '../utils/base.ts';

const tutorials = await getCollection('tutorial');
const t = tutorials.find(t => t.slug === 'tutorial');
const { Content } = t ? await t.render() : { Content: null };
---

<Layout title="用户指南 - UOMP" description="从安装、导入笔记到在 Claude Desktop / Cursor 中授权读取、审计和撤销" switchHref={`${baseUrl}en/tutorial/`}>
  <section>
    <div class="container">
      <div class="sec-eyebrow">
        <div class="sec-num">指南</div>
        <span class="sec-tag">真实用户上手</span>
      </div>
      {Content && <Content />}
      <div class="hero-btns" style="margin-top: 2.5rem;">
        <a href={`${baseUrl}spec/`} class="btn-h1">协议规范 →</a>
        <a href={`${baseUrl}design/`} class="btn-h1">实现设计 →</a>
        <a href="https://github.com/0xSynapse/uomp-core" target="_blank" rel="noopener" class="btn-h2">GitHub</a>
      </div>
    </div>
  </section>
</Layout>
