---
import { baseUrl } from '../utils/base.ts';

export interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const specHref = lang === 'zh' ? `${baseUrl}spec/` : `${baseUrl}en/spec/`;
const aegisHref = 'https://heurion.org/aegis-os/';
const aegisTutorialHref = 'https://heurion.org/aegis-os/tutorial/';

const content = {
  zh: {
    eyebrow: 'AEGIS OS · 记忆同意协议',
    h1a: '让 Agent 请求记忆，',
    h1b: '让运行时执行同意。',
    sub: 'UOMP 定义 Agent 如何请求个人记忆：范围、时效、撤销与审计。它是 Aegis OS 的 memory module，由 Aegis 原生执行。',
    ctaPrimary: '阅读协议',
    ctaSecondary: 'Aegis OS 概览',
    ctaTutorial: 'Aegis OS 安装教程',
    meta: ['开放协议草案', 'Apache 2.0', 'Aegis OS memory module', 'Heurion Research'],
    tutorialHref: `${baseUrl}tutorial/`,
    roadmapHref: `${baseUrl}roadmap/`,
    editorial: [
      { label: '协议', text: '定义 Agent 如何声明范围、请求同意、续租与撤销。' },
      { label: '执行', text: 'Aegis OS 用沙箱、策略、租约与可信审批把协议变成边界。' },
    ],
    consent: {
      label: '同意请求',
      timer: '00:29:41',
      agent: 'Claude Desktop',
      agentMeta: 'MCP 客户端 · Aegis OS',
      badge: '只读',
      requested: '请求范围',
      allow: '读取',
      allowPath: 'notes/projects/**',
      deny: '拒绝',
      denyPath: 'notes/journal/**',
      session: '会话',
      sessionValue: '30 分钟',
      data: '数据',
      dataValue: '留在本机',
      denyBtn: '拒绝',
      allowBtn: '允许 30 分钟',
      preview: '同意流程示意',
    },
    audit: {
      title: '审计',
      session: '会话 7f3a',
      rows: [
        { time: '14:32:07', kind: 'allow', label: '允许', text: 'notes/projects/roadmap.md' },
        { time: '14:32:09', kind: 'deny', label: '拒绝', text: 'notes/journal/2026-10.md' },
        { time: '14:35:12', kind: 'revoke', label: '撤销', text: 'session 7f3a' },
      ],
    },
    status: {
      todayLabel: '今天',
      today: '协议草案 · Agent 发起 · 范围与租约 · 本地审批 · 可撤销 · 审计',
      nextLabel: '下一步',
      next: 'Aegis OS 原生实现已完成 · 统一 Web Trusted UI · 远程 Agent · conformance suite',
    },
    how: {
      kicker: '协议模型',
      title: '三件事：声明、请求、执行。',
      intro: 'UOMP 不复制你的数据。它定义 Agent 如何提出访问请求，以及运行时如何证明自己遵守了同意。',
      steps: [
        {
          n: '01',
          title: '声明',
          body: 'Agent 在 manifest 里声明它需要的记忆范围。按 tag、key、field 收窄，并明确写出不能读什么。',
          codeLabel: 'uom.json',
          code: [
            '"requested_scopes": {',
            '  "read": {',
            '    "tags": ["notes/projects"],',
            '    "deny_tags": ["notes/journal"]',
            '  }',
            '}',
          ].join('\n'),
        },
        {
          n: '02',
          title: '请求同意',
          body: 'Agent 通过运行时请求范围；UOMP 定义请求载荷，Aegis OS 创建 consent request。用户在 CLI 只批准这次请求，默认 30 分钟。',
          codeLabel: 'protocol',
          code: [
            'agent → runtime',
            '{ "scope": ["notes/projects"],',
            '  "ttl": "30m" }',
            '',
            'runtime → user',
            'consent · notes/projects · 30m',
          ].join('\n'),
        },
        {
          n: '03',
          title: '执行',
          body: '运行时在每次读取前检查范围、租约和撤销状态。撤销后，下一个请求立即失效。',
          codeLabel: 'runtime',
          code: [
            'Aegis OS policy',
            'scope ✓ · lease ✓ · revoke ✓',
            '',
            'audit → append-only',
          ].join('\n'),
        },
      ],
    },
    guarantees: {
      kicker: '执行边界',
      title: '协议定义边界，运行时负责执行。',
      intro: 'Aegis OS 在请求路径里执行这些约束：Agent 通过受控接口访问记忆，不持有审批凭证。',
      rows: [
        { key: '范围', value: 'tag、key、field 白名单；deny 规则优先。' },
        { key: '时间', value: '租约到期即失效，默认 30 分钟。' },
        { key: '撤销', value: '每个请求都检查租约状态；revoke 立即生效。' },
        { key: '审计', value: '每次允许和拒绝都记录 Agent、范围和时间。' },
        { key: '隔离', value: 'Agent 在沙箱中运行，只通过受控接口访问记忆。' },
        { key: '审批', value: '审批由可信 UI 完成；Agent 不能自己批准自己。' },
      ],
      note: '本地优先：Aegis OS 在用户设备上执行策略，数据留在你已有的存储里。',
    },
    scope: {
      kicker: '边界',
      title: '一个协议，不是又一个记忆库。',
      intro: 'UOMP 定义访问方式；数据留在你已有的存储里。',
      isTitle: 'UOMP 是',
      is: [
        'Agent 记忆同意的开放协议',
        '范围、时效、撤销与审计的语义',
        '与 MCP 互补的授权层',
        '由 Heurion Research 维护',
      ],
      notTitle: 'UOMP 不是',
      not: [
        '记忆数据库或向量库',
        'Obsidian、Notion 或 Mem0 的替代品',
        '模型、Agent 框架或云服务',
        '某个产品的私有接口',
      ],
      outTitle: '当前不在主线上',
      out: ['FHE', '链上审计', '新存储后端', 'Agent Registry', '写入流程'],
    },
    protocol: {
      kicker: '协议与实现',
      title: 'UOMP 定义请求，Aegis OS 执行同意。',
      intro: '协议保持开放，执行交给可信运行时。两者共同构成完整的记忆访问控制面。',
      cards: [
        {
          label: 'UOMP · 协议',
          title: '记忆同意的开放规范',
          body: '定义 Agent 如何声明范围、请求同意、获得租约、撤销与审计。',
          points: ['范围：tag / key / field', '租约：限时、可撤销', '审计：每次允许与拒绝'],
          link: '阅读规范',
          href: specHref,
        },
        {
          label: 'Aegis OS · 原生模块',
          title: '执行协议的原生运行时',
          body: '把协议语义落到沙箱、策略、租约与可信审批上。',
          points: ['内核沙箱与独立运行时', 'Policy + lease + escalation', '可信审批与审计记录'],
          link: '了解 Aegis OS',
          href: aegisHref,
        },
      ],
    },
    cta: {
      kicker: '参与',
      title: '一起定义记忆同意的标准。',
      body: 'UOMP 还是草案。我们想和正在把 Agent 接入个人数据的团队一起，把范围、租约和审批语义定清楚。',
      primary: '参与协议讨论',
      secondary: '阅读路线图',
    },
  },
  en: {
    eyebrow: 'AEGIS OS · MEMORY CONSENT PROTOCOL',
    h1a: 'Agents ask for memory.',
    h1b: 'Runtimes enforce consent.',
    sub: 'UOMP defines how agents ask for personal memory: scope, duration, revocation, and audit. It is the memory module of Aegis OS, enforced natively by Aegis.',
    ctaPrimary: 'Read the protocol',
    ctaSecondary: 'Aegis OS overview',
    ctaTutorial: 'Aegis OS install tutorial',
    meta: ['Open protocol draft', 'Apache 2.0', 'Aegis OS memory module', 'Heurion Research'],
    tutorialHref: `${baseUrl}en/tutorial/`,
    roadmapHref: `${baseUrl}en/roadmap/`,
    editorial: [
      { label: 'Protocol', text: 'Defines how an agent declares scope, requests consent, renews, and revokes.' },
      { label: 'Enforcement', text: 'Aegis OS turns the protocol into a boundary with sandboxing, policy, leases, and trusted approval.' },
    ],
    consent: {
      label: 'Consent request',
      timer: '00:29:41',
      agent: 'Claude Desktop',
      agentMeta: 'MCP client · Aegis OS',
      badge: 'read-only',
      requested: 'Requested scope',
      allow: 'read',
      allowPath: 'notes/projects/**',
      deny: 'deny',
      denyPath: 'notes/journal/**',
      session: 'Session',
      sessionValue: '30 minutes',
      data: 'Data',
      dataValue: 'Stays on this device',
      denyBtn: 'Deny',
      allowBtn: 'Allow for 30 min',
      preview: 'Consent flow preview',
    },
    audit: {
      title: 'Audit',
      session: 'Session 7f3a',
      rows: [
        { time: '14:32:07', kind: 'allow', label: 'allow', text: 'notes/projects/roadmap.md' },
        { time: '14:32:09', kind: 'deny', label: 'deny', text: 'notes/journal/2026-10.md' },
        { time: '14:35:12', kind: 'revoke', label: 'revoke', text: 'session 7f3a' },
      ],
    },
    status: {
      todayLabel: 'Today',
      today: 'Protocol draft · agent-initiated · scope & lease · local consent · revocable · audit',
      nextLabel: 'Next',
      next: 'Native Aegis OS runtime complete · unified web trusted UI · remote Agent · conformance suite',
    },
    how: {
      kicker: 'Protocol model',
      title: 'Three moves: declare, request, enforce.',
      intro: 'UOMP does not copy your data. It defines how an agent asks for access, and how a runtime proves that consent was respected.',
      steps: [
        {
          n: '01',
          title: 'Declare',
          body: 'The agent ships a manifest with the memory scopes it needs. Narrow by tag, key, or field — and state what it must not read.',
          codeLabel: 'uom.json',
          code: [
            '"requested_scopes": {',
            '  "read": {',
            '    "tags": ["notes/projects"],',
            '    "deny_tags": ["notes/journal"]',
            '  }',
            '}',
          ].join('\n'),
        },
        {
          n: '02',
          title: 'Request consent',
          body: 'The agent asks the runtime for a scope; UOMP defines the request payload and Aegis OS opens the local consent page. The user approves one request for 30 minutes by default.',
          codeLabel: 'protocol',
          code: [
            'agent → runtime',
            '{ "scope": ["notes/projects"],',
            '  "ttl": "30m" }',
            '',
            'runtime → user',
            'consent · notes/projects · 30m',
          ].join('\n'),
        },
        {
          n: '03',
          title: 'Enforce',
          body: 'The runtime checks scope, lease, and revocation before every read. Revoking ends access on the next request.',
          codeLabel: 'runtime',
          code: [
            'Aegis OS policy',
            'scope ✓ · lease ✓ · revoke ✓',
            '',
            'audit → append-only',
          ].join('\n'),
        },
      ],
    },
    guarantees: {
      kicker: 'Enforcement boundary',
      title: 'The protocol defines the boundary. The runtime enforces it.',
      intro: 'Aegis OS enforces these constraints in the request path: the agent reaches memory through a controlled interface and never holds the approval credential.',
      rows: [
        { key: 'Scope', value: 'Tag, key, and field allowlists. Deny rules win.' },
        { key: 'Time', value: 'Leases expire. 30 minutes by default.' },
        { key: 'Revocation', value: 'Lease state is checked on every request. Revoke takes effect immediately.' },
        { key: 'Audit', value: 'Every allow and deny is recorded with the agent, scope, and timestamp.' },
        { key: 'Isolation', value: 'The agent runs in a sandbox and reaches memory only through a controlled interface.' },
        { key: 'Approval', value: 'Approval happens in a trusted UI; the agent cannot approve itself.' },
      ],
      note: 'Local-first: Aegis OS enforces policy on the user device, and the data stays in the store you already use.',
    },
    scope: {
      kicker: 'Boundary',
      title: 'A protocol, not another memory store.',
      intro: 'UOMP defines how access happens; the data stays in the store you already use.',
      isTitle: 'UOMP is',
      is: [
        'An open protocol for agent memory consent',
        'Semantics for scope, duration, revocation, and audit',
        'A consent layer complementary to MCP',
        'Maintained by Heurion Research',
      ],
      notTitle: 'UOMP is not',
      not: [
        'A memory database or vector store',
        'A replacement for Obsidian, Notion, or Mem0',
        'A model, agent framework, or cloud',
        'A private interface for one product',
      ],
      outTitle: 'Not on the critical path',
      out: ['FHE', 'On-chain audit', 'New storage backends', 'Agent registry', 'Writes'],
    },
    protocol: {
      kicker: 'Protocol & implementation',
      title: 'UOMP defines the request. Aegis OS enforces consent.',
      intro: 'The protocol stays open; enforcement belongs to a trusted runtime. Together they form the full memory access control plane.',
      cards: [
        {
          label: 'UOMP · Protocol',
          title: 'The open memory consent spec',
          body: 'Defines how an agent declares scope, requests consent, receives a lease, revokes, and audits.',
          points: ['Scope: tag / key / field', 'Lease: time-limited, revocable', 'Audit: every allow and deny'],
          link: 'Read the spec',
          href: specHref,
        },
        {
          label: 'Aegis OS · Native module',
          title: 'The native runtime that enforces it',
          body: 'Turns protocol semantics into sandboxing, policy, leases, and trusted approval.',
          points: ['Kernel sandbox & standalone runtime', 'Policy + lease + escalation', 'Trusted approval & audit records'],
          link: 'Explore Aegis OS',
          href: aegisHref,
        },
      ],
    },
    cta: {
      kicker: 'Participate',
      title: 'Help define the standard for memory consent.',
      body: 'UOMP is still a draft. We want to work with teams connecting agents to personal data to settle scope, lease, and approval semantics.',
      primary: 'Join the protocol discussion',
      secondary: 'Read the roadmap',
    },
  },
};

const t = content[lang];
---

<div class="home">
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="kicker">{t.eyebrow}</div>
        <h1>{t.h1a}<span>{t.h1b}</span></h1>
        <p class="hero-sub">{t.sub}</p>
        <div class="hero-actions">
          <a class="btn-solid" href={specHref}>{t.ctaPrimary} <span aria-hidden="true">→</span></a>
          <a class="btn-line" href={aegisHref} target="_blank" rel="noopener">{t.ctaSecondary} <span aria-hidden="true">↗</span></a>
          <a class="link-quiet" href={aegisTutorialHref} target="_blank" rel="noopener">{t.ctaTutorial} <span aria-hidden="true">↗</span></a>
          <a class="link-quiet" href="https://github.com/heurion-org/aegis-os/tree/main/modules/uomp" target="_blank" rel="noopener">GitHub</a>
        </div>
        <div class="hero-meta">
          {t.meta.map((m) => <span>{m}</span>)}
        </div>

        <div class="hero-editorial">
          {t.editorial.map((row) => (
            <div class="editorial-row">
              <span class="editorial-label">{row.label}</span>
              <p>{row.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-demo">
        <div class="consent">
          <div class="consent-head">
            <span>{t.consent.label}</span>
            <span class="timer">{t.consent.timer}</span>
          </div>
          <div class="consent-body">
            <div class="agent">
              <div class="agent-mark">C</div>
              <div class="agent-name">
                <strong>{t.consent.agent}</strong>
                <span>{t.consent.agentMeta}</span>
              </div>
              <span class="agent-badge">{t.consent.badge}</span>
            </div>

            <div class="scope-block">
              <div class="scope-label">{t.consent.requested}</div>
              <div class="scope-row">
                <span class="pill allow">{t.consent.allow}</span>
                <code>{t.consent.allowPath}</code>
              </div>
              <div class="scope-row">
                <span class="pill deny">{t.consent.deny}</span>
                <code>{t.consent.denyPath}</code>
              </div>
            </div>

            <dl class="consent-meta">
              <div><dt>{t.consent.session}</dt><dd>{t.consent.sessionValue}</dd></div>
              <div><dt>{t.consent.data}</dt><dd>{t.consent.dataValue}</dd></div>
            </dl>
          </div>
          <div class="consent-actions">
            <span class="btn-deny">{t.consent.denyBtn}</span>
            <span class="btn-allow">{t.consent.allowBtn}</span>
          </div>
          <div class="consent-foot">{t.consent.preview}</div>
        </div>

        <div class="audit">
          <div class="audit-head">
            <span>{t.audit.title}</span>
            <span>{t.audit.session}</span>
          </div>
          {t.audit.rows.map((row) => (
            <div class="audit-row">
              <span class="time">{row.time}</span>
              <span class={`kind ${row.kind}`}>{row.label}</span>
              <code>{row.text}</code>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="status-strip">
        <div class="status-item">
          <span class="status-label">{t.status.todayLabel}</span>
          <span>{t.status.today}</span>
        </div>
        <div class="status-item">
          <span class="status-label next">{t.status.nextLabel}</span>
          <span>{t.status.next}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.how.kicker}</div>
          <h2>{t.how.title}</h2>
        </div>
        <p>{t.how.intro}</p>
      </div>

      <div class="how-steps">
        {t.how.steps.map((step) => (
          <article class="how-step">
            <span class="how-num">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <div class="code-label">{step.codeLabel}</div>
            <pre class="code"><code>{step.code}</code></pre>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.guarantees.kicker}</div>
          <h2>{t.guarantees.title}</h2>
        </div>
        <p>{t.guarantees.intro}</p>
      </div>

      <div class="guarantee-table">
        {t.guarantees.rows.map((row) => (
          <div class="guarantee-row">
            <span class="guarantee-key">{row.key}</span>
            <span class="guarantee-value">{row.value}</span>
          </div>
        ))}
      </div>
      <p class="guarantee-note">{t.guarantees.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.scope.kicker}</div>
          <h2>{t.scope.title}</h2>
        </div>
        <p>{t.scope.intro}</p>
      </div>

      <div class="scope-grid">
        <div class="scope-col">
          <h3>{t.scope.isTitle}</h3>
          <ul class="plain-list yes">
            {t.scope.is.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="scope-col">
          <h3>{t.scope.notTitle}</h3>
          <ul class="plain-list no">
            {t.scope.not.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="out-of-scope">
        <span class="out-label">{t.scope.outTitle}</span>
        <ul class="tags">
          {t.scope.out.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section protocol-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.protocol.kicker}</div>
          <h2>{t.protocol.title}</h2>
        </div>
        <p>{t.protocol.intro}</p>
      </div>

      <div class="protocol-grid">
        {t.protocol.cards.map((card) => (
          <article class="protocol-card">
            <div class="protocol-label">{card.label}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <ul class="protocol-points">
              {card.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="link-arrow" href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noopener' : undefined}>
              {card.link} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="partner-cta">
    <div class="wrap cta-inner">
      <div>
        <div class="kicker">{t.cta.kicker}</div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.body}</p>
      </div>
      <div class="cta-actions">
        <a class="btn-solid" href="https://github.com/heurion-org/aegis-os/issues/new" target="_blank" rel="noopener">{t.cta.primary}</a>
        <a class="btn-line" href={t.roadmapHref}>{t.cta.secondary}</a>
      </div>
    </div>
  </section>
</div>

<style>
  .home {
    --paper: #FAF8F4;
    --surface: #FDFCF9;
    --ink: #151C19;
    --muted: #4A534E;
    --faint: #646D68;
    --line: #DFDAD0;
    --line-strong: #C9C2B6;
    --accent: #233E33;
    --accent-soft: #E3ECE7;
    --warn: #8F5638;
    --warn-soft: #F3EAE3;
    --mono: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;

    background: var(--paper);
    color: var(--ink);
  }

  .home section {
    border-bottom: 0;
    background: transparent;
  }

  .home .protocol-section {
    background: var(--off2);
  }

  .wrap {
    width: min(1220px, calc(100% - 7rem));
    margin: 0 auto;
  }

  .home-hero {
    padding: 0;
