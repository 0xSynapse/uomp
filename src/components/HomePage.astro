---
import { baseUrl } from '../utils/base.ts';

export interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;

const content = {
  zh: {
    eyebrow: '面向 AI Agent 的授权与审计层',
    h1a: '数据留在原地。',
    h1b: '访问必须明确。',
    sub: 'UOMP 位于 Agent 和它想读的数据之间。每次读取都有范围、有时限、有记录。撤销在下一个请求生效，而不是第二天。',
    ctaPrimary: '看它怎么工作',
    ctaSecondary: '阅读用户指南',
    meta: ['本地优先', '不上传数据', '开放协议', 'Apache 2.0'],
    tutorialHref: `${baseUrl}tutorial/`,
    roadmapHref: `${baseUrl}roadmap/`,
    consent: {
      label: '授权请求',
      timer: '00:29:41',
      agent: 'Claude Desktop',
      agentMeta: 'MCP 客户端',
      badge: '只读',
      requested: '请求范围',
      allow: '读取',
      allowPath: 'notes/projects/**',
      deny: '拒绝',
      denyPath: 'notes/journal/**',
      session: '会话',
      sessionValue: '30 分钟',
      data: '数据',
      dataValue: '留在本机',
      denyBtn: '拒绝',
      allowBtn: '允许 30 分钟',
      preview: '授权流程示意',
    },
    audit: {
      title: '审计',
      session: '会话 7f3a',
      rows: [
        { time: '14:32:07', kind: 'allow', label: '允许', text: 'notes/projects/roadmap.md' },
        { time: '14:32:09', kind: 'deny', label: '拒绝', text: 'notes/journal/2026-10.md' },
        { time: '14:35:12', kind: 'revoke', label: '撤销', text: 'session 7f3a' },
      ],
    },
    status: {
      todayLabel: '今天',
      today: 'CLI 授权 · Markdown/Obsidian 导入 · MCP 实验 · 撤销 · 审计',
      nextLabel: '下一步',
      next: 'MCP 客户端验证 · 打包 CLI · 审计时间线',
    },
    how: {
      kicker: '工作方式',
      title: '三步，每次请求都检查。',
      intro: 'UOMP 不把你的数据复制到另一个存储。它挡在你已有的数据前面，决定一个请求是否可以通过。',
      steps: [
        {
          n: '01',
          title: '声明',
          body: 'Agent 在 manifest 里声明它需要的范围。按 tag、key、field 收窄，并明确写出不能读什么。',
          codeLabel: 'uom.json',
          code: [
            '"requested_scopes": {',
            '  "read": {',
            '    "tags": ["notes/projects"],',
            '    "deny_tags": ["notes/journal"]',
            '  }',
            '}',
          ].join('\n'),
        },
        {
          n: '02',
          title: '授权',
          body: '你只授权一个会话，范围明确、时间有限。默认 30 分钟。',
          codeLabel: 'terminal',
          code: [
            '$ uomp authorize ./agent \\',
            '    --scope notes/projects \\',
            '    --duration 30',
            '',
            '✓ session 7f3a · env file written',
          ].join('\n'),
        },
        {
          n: '03',
          title: '执行',
          body: 'Guard 在每次读取前检查范围、过期和撤销状态。撤销后，下一个请求立即失效。',
          codeLabel: 'terminal',
          code: [
            '$ uomp revoke 7f3a',
            '✓ revoked',
            '',
            'GET /v1/memory  →  403',
          ].join('\n'),
        },
      ],
    },
    guarantees: {
      kicker: '执行',
      title: '返回任何数据之前，先过四道检查。',
      intro: '这些保证在请求路径里执行，不是写在文档里。',
      rows: [
        { key: '范围', value: 'tag、key、field 白名单；deny 规则优先。' },
        { key: '时间', value: '会话会过期，默认 30 分钟。' },
        { key: '撤销', value: '每个请求都检查会话状态；revoke 或 close 立即生效。' },
        { key: '审计', value: '每次允许和拒绝都记录 Agent、范围和时间。' },
      ],
      note: '默认本地优先：Guard 只监听 127.0.0.1，数据留在你已有的存储里。',
    },
    scope: {
      kicker: '边界',
      title: '是访问的控制面，不是又一个记忆库。',
      intro: 'UOMP 治理已经存在的数据，不试图成为数据存放的地方。',
      isTitle: 'UOMP 是',
      is: [
        '本地的授权、撤销与审计层',
        '治理你已有数据的访问方式',
        '开放协议 + 参考实现',
        'MCP 的补充层',
      ],
      notTitle: 'UOMP 不是',
      not: [
        '记忆数据库或向量库',
        'Obsidian、Notion 或 Mem0 的替代品',
        '模型、Agent 框架或云服务',
        '区块链或 FHE 产品',
      ],
      outTitle: '当前不在主线上',
      out: ['FHE', '链上审计', '新存储后端', 'Agent Registry', '写入流程'],
    },
    cta: {
      kicker: '设计伙伴',
      title: '成为最早 10 个设计伙伴之一。',
      body: '如果你的笔记在 Obsidian 或 Markdown 里，而且你在用不止一个 Agent，我们想了解你的工作流——不是收一张功能清单。',
      primary: '成为设计伙伴',
      secondary: '阅读路线图',
    },
  },
  en: {
    eyebrow: 'Consent and audit layer for AI agents',
    h1a: 'Your data stays.',
    h1b: 'Access is explicit.',
    sub: 'UOMP sits between an agent and the data it wants. Every read is scoped, time-limited, and logged. Revocation takes effect on the next request — not the next day.',
    ctaPrimary: 'See how it works',
    ctaSecondary: 'Read the user guide',
    meta: ['Local-first', 'No data upload', 'Open protocol', 'Apache 2.0'],
    tutorialHref: `${baseUrl}en/tutorial/`,
    roadmapHref: `${baseUrl}en/roadmap/`,
    consent: {
      label: 'Authorization request',
      timer: '00:29:41',
      agent: 'Claude Desktop',
      agentMeta: 'MCP client',
      badge: 'read-only',
      requested: 'Requested scope',
      allow: 'read',
      allowPath: 'notes/projects/**',
      deny: 'deny',
      denyPath: 'notes/journal/**',
      session: 'Session',
      sessionValue: '30 minutes',
      data: 'Data',
      dataValue: 'Stays on this device',
      denyBtn: 'Deny',
      allowBtn: 'Allow for 30 min',
      preview: 'Authorization flow preview',
    },
    audit: {
      title: 'Audit',
      session: 'Session 7f3a',
      rows: [
        { time: '14:32:07', kind: 'allow', label: 'allow', text: 'notes/projects/roadmap.md' },
        { time: '14:32:09', kind: 'deny', label: 'deny', text: 'notes/journal/2026-10.md' },
        { time: '14:35:12', kind: 'revoke', label: 'revoke', text: 'session 7f3a' },
      ],
    },
    status: {
      todayLabel: 'Today',
      today: 'CLI grants · Markdown/Obsidian import · MCP experimental · revoke · audit',
      nextLabel: 'Next',
      next: 'MCP client validation · packaged CLI · audit timeline',
    },
    how: {
      kicker: 'How it works',
      title: 'Three steps. Checked on every request.',
      intro: 'UOMP does not copy your data into another store. It sits in front of the data you already have and decides whether a request is allowed.',
      steps: [
        {
          n: '01',
          title: 'Declare',
          body: 'The agent ships a manifest with the scopes it needs. Narrow by tag, key, or field — and state what it must not read.',
          codeLabel: 'uom.json',
          code: [
            '"requested_scopes": {',
            '  "read": {',
            '    "tags": ["notes/projects"],',
            '    "deny_tags": ["notes/journal"]',
            '  }',
            '}',
          ].join('\n'),
        },
        {
          n: '02',
          title: 'Approve',
          body: 'You grant one session with an explicit scope and a time limit. The default is 30 minutes.',
          codeLabel: 'terminal',
          code: [
            '$ uomp authorize ./agent \\',
            '    --scope notes/projects \\',
            '    --duration 30',
            '',
            '✓ session 7f3a · env file written',
          ].join('\n'),
        },
        {
          n: '03',
          title: 'Enforce',
          body: 'Guard checks scope, expiry, and revocation before every read. Revoking ends access on the next request.',
          codeLabel: 'terminal',
          code: [
            '$ uomp revoke 7f3a',
            '✓ revoked',
            '',
            'GET /v1/memory  →  403',
          ].join('\n'),
        },
      ],
    },
    guarantees: {
      kicker: 'Enforcement',
      title: 'Four checks before any data is returned.',
      intro: 'The guarantees live in the request path, not in the documentation.',
      rows: [
        { key: 'Scope', value: 'Tag, key, and field allowlists. Deny rules win.' },
        { key: 'Time', value: 'Sessions expire. 30 minutes by default.' },
        { key: 'Revocation', value: 'Session state is checked on every request. Revoke or close takes effect immediately.' },
        { key: 'Audit', value: 'Every allow and deny is recorded with the agent, scope, and timestamp.' },
      ],
      note: 'Local-first by default: Guard binds to 127.0.0.1, and the data stays in the store you already use.',
    },
    scope: {
      kicker: 'Scope',
      title: 'A control plane, not another memory store.',
      intro: 'UOMP governs data that already exists. It does not try to become the place where that data lives.',
      isTitle: 'UOMP is',
      is: [
        'A local consent, authorization, and audit layer',
        'A way to govern access to data you already have',
        'An open protocol with a reference implementation',
        'Complementary to MCP',
      ],
      notTitle: 'UOMP is not',
      not: [
        'A memory database or vector store',
        'A replacement for Obsidian, Notion, or Mem0',
        'A model, agent framework, or cloud',
        'A blockchain or FHE product',
      ],
      outTitle: 'Not on the critical path',
      out: ['FHE', 'On-chain audit', 'New storage backends', 'Agent registry', 'Writes'],
    },
    cta: {
      kicker: 'Design partners',
      title: 'Become one of our first ten design partners.',
      body: 'If you keep your notes in Obsidian or Markdown and use more than one agent, we want your workflow — not a feature request.',
      primary: 'Become a design partner',
      secondary: 'Read the roadmap',
    },
  },
};

const t = content[lang];
---

<div class="home">
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="kicker">{t.eyebrow}</div>
        <h1>{t.h1a}<span>{t.h1b}</span></h1>
        <p class="hero-sub">{t.sub}</p>
        <div class="hero-actions">
          <a class="btn-solid" href="#how">{t.ctaPrimary}</a>
          <a class="btn-line" href={t.tutorialHref}>{t.ctaSecondary}</a>
          <a class="link-quiet" href="https://github.com/0xSynapse/uomp-core" target="_blank" rel="noopener">GitHub</a>
        </div>
        <div class="hero-meta">
          {t.meta.map((m) => <span>{m}</span>)}
        </div>
      </div>

      <div class="hero-demo">
        <div class="consent">
          <div class="consent-head">
            <span>{t.consent.label}</span>
            <span class="timer">{t.consent.timer}</span>
          </div>
          <div class="consent-body">
            <div class="agent">
              <div class="agent-mark">C</div>
              <div class="agent-name">
                <strong>{t.consent.agent}</strong>
                <span>{t.consent.agentMeta}</span>
              </div>
              <span class="agent-badge">{t.consent.badge}</span>
            </div>

            <div class="scope-block">
              <div class="scope-label">{t.consent.requested}</div>
              <div class="scope-row">
                <span class="pill allow">{t.consent.allow}</span>
                <code>{t.consent.allowPath}</code>
              </div>
              <div class="scope-row">
                <span class="pill deny">{t.consent.deny}</span>
                <code>{t.consent.denyPath}</code>
              </div>
            </div>

            <dl class="consent-meta">
              <div><dt>{t.consent.session}</dt><dd>{t.consent.sessionValue}</dd></div>
              <div><dt>{t.consent.data}</dt><dd>{t.consent.dataValue}</dd></div>
            </dl>
          </div>
          <div class="consent-actions">
            <span class="btn-deny">{t.consent.denyBtn}</span>
            <span class="btn-allow">{t.consent.allowBtn}</span>
          </div>
          <div class="consent-foot">{t.consent.preview}</div>
        </div>

        <div class="audit">
          <div class="audit-head">
            <span>{t.audit.title}</span>
            <span>{t.audit.session}</span>
          </div>
          {t.audit.rows.map((row) => (
            <div class="audit-row">
              <span class="time">{row.time}</span>
              <span class={`kind ${row.kind}`}>{row.label}</span>
              <code>{row.text}</code>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="status-strip">
        <div class="status-item">
          <span class="status-label">{t.status.todayLabel}</span>
          <span>{t.status.today}</span>
        </div>
        <div class="status-item">
          <span class="status-label next">{t.status.nextLabel}</span>
          <span>{t.status.next}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.how.kicker}</div>
          <h2>{t.how.title}</h2>
        </div>
        <p>{t.how.intro}</p>
      </div>

      <div class="how-steps">
        {t.how.steps.map((step) => (
          <article class="how-step">
            <span class="how-num">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <div class="code-label">{step.codeLabel}</div>
            <pre class="code"><code>{step.code}</code></pre>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.guarantees.kicker}</div>
          <h2>{t.guarantees.title}</h2>
        </div>
        <p>{t.guarantees.intro}</p>
      </div>

      <div class="guarantee-table">
        {t.guarantees.rows.map((row) => (
          <div class="guarantee-row">
            <span class="guarantee-key">{row.key}</span>
            <span class="guarantee-value">{row.value}</span>
          </div>
        ))}
      </div>
      <p class="guarantee-note">{t.guarantees.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">{t.scope.kicker}</div>
          <h2>{t.scope.title}</h2>
        </div>
        <p>{t.scope.intro}</p>
      </div>

      <div class="scope-grid">
        <div class="scope-col">
          <h3>{t.scope.isTitle}</h3>
          <ul class="plain-list yes">
            {t.scope.is.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="scope-col">
          <h3>{t.scope.notTitle}</h3>
          <ul class="plain-list no">
            {t.scope.not.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="out-of-scope">
        <span class="out-label">{t.scope.outTitle}</span>
        <ul class="tags">
          {t.scope.out.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="partner-cta">
    <div class="wrap cta-inner">
      <div>
        <div class="kicker">{t.cta.kicker}</div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.body}</p>
      </div>
      <div class="cta-actions">
        <a class="btn-solid" href="https://github.com/0xSynapse/uomp-core/issues/new" target="_blank" rel="noopener">{t.cta.primary}</a>
        <a class="btn-line" href={t.roadmapHref}>{t.cta.secondary}</a>
      </div>
    </div>
  </section>
</div>

<style>
  .home {
    --paper: #fbfbf8;
    --surface: #ffffff;
    --ink: #111210;
    --muted: #62655f;
    --faint: #6f726a;
    --line: #e3e3dc;
    --line-strong: #cfcfc6;
    --accent: #1f5f4a;
    --accent-soft: #eef5f1;
    --warn: #8a4b12;
    --warn-soft: #fbf3ea;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    background: var(--paper);
    color: var(--ink);
  }

  .home section {
    border-bottom: 0;
    background: transparent;
  }

  .wrap {
    width: min(1180px, calc(100% - 64px));
    margin: 0 auto;
  }

  .home-hero {
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 72px;
    align-items: center;
    padding: 84px 0 56px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .home-hero h1 {
    margin: 22px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(40px, 4.9vw, 58px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .home-hero h1 span {
    display: block;
    color: var(--muted);
  }

  .hero-sub {
    max-width: 520px;
    margin: 24px 0 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .btn-solid,
  .btn-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .btn-solid {
    background: var(--ink);
    color: #fff;
    border: 1px solid var(--ink);
  }

  .btn-solid:hover {
    background: #2a2c28;
  }

  .btn-line {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .btn-line:hover {
    border-color: var(--ink);
  }

  .link-quiet {
    margin-left: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }

  .link-quiet:hover {
    color: var(--ink);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 32px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .hero-meta span {
    position: relative;
    padding-right: 18px;
  }

  .hero-meta span:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--line-strong);
    transform: translateY(-50%);
  }

  /* ── Consent mock ── */
  .hero-demo {
    min-width: 0;
  }

  .consent {
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 30px 60px -36px rgba(17, 18, 16, 0.35);
    overflow: hidden;
  }

  .consent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .timer {
    color: var(--ink);
    letter-spacing: 0.06em;
  }

  .consent-body {
    padding: 18px 18px 16px;
  }

  .agent {
    display: flex;
    align-items: center;
    gap: 11px;
    padding-bottom: 16px;
  }

  .agent-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 16px;
    flex: none;
  }

  .agent-name {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .agent-name strong {
    font-size: 13.5px;
    font-weight: 600;
  }

  .agent-name span {
    font-size: 11px;
    color: var(--faint);
  }

  .agent-badge {
    margin-left: auto;
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .scope-block {
    border-top: 1px solid var(--line);
    padding-top: 13px;
  }

  .scope-label {
    margin-bottom: 2px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .scope-row {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 0;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink);
