---
export interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const stats = lang === 'zh'
  ? [{ v: '本地优先', l: '数据留在原地' },{ v: '最小范围', l: 'tag / key / field' },{ v: '即时撤销', l: '下一个请求 403' },{ v: '可审计', l: '每次决策都有日志' },{ v: 'MCP', l: 'connect + 按需审批' }]
  : [{ v: 'Local-first', l: 'Data stays where it is' },{ v: 'Scoped', l: 'tag / key / field' },{ v: 'Revocable', l: '403 on the next request' },{ v: 'Auditable', l: 'Every decision logged' },{ v: 'MCP', l: 'connect + on-demand consent' }];
---
<div class="window-wrap">
  <div class="window">
    <div class="window-bar">
      <div class="window-dots"><div class="window-dot r"></div><div class="window-dot y"></div><div class="window-dot g"></div></div>
    </div>
    <div class="window-body" id="terminal-demo" data-lang={lang} style="padding:20px;font-family:monospace;font-size:0.82rem;color:#D1D5DB;text-align:left;min-height:160px;max-height:200px;overflow-y:auto;line-height:1.7;">
    </div>
  </div>
  <div class="stats-bar">
    {stats.map(s => <div class="stat-item"><span class="stat-val">{s.v}</span><span class="stat-lbl">{s.l}</span></div>)}
  </div>
</div>

<script>
(function() {
  const el = document.getElementById('terminal-demo');
  if (!el) return;
  const C = { g: '#9CA3AF', w: '#F9FAFB', gn: '#34D399', dim: '#6B7280' };
  const zh = el.dataset.lang === 'zh';
  const frames = [
    `<span style="color:${C.g}">$</span> <span style="color:${C.w}">uomp connect ./my-agent --vault ~/Obsidian/MyVault --scope notes/projects</span><br><span style="color:${C.gn}">\u2713 ${zh ? '128 条 · 会话 · env 文件已写入' : '128 items \u00b7 session \u00b7 env file written'}</span><br>`,
    `<span style="color:${C.g}">$</span> <span style="color:${C.w}">node my-agent.js</span><br><span style="color:${C.g}">${zh ? '12 次读取 \u00b7 3 次被范围拦截' : '12 reads \u00b7 3 blocked by scope'}</span><br><span style="color:${C.gn}">\u2713 ${zh ? '每次读取都有日志' : 'every read logged'}</span><br>`,
    `<span style="color:${C.g}">$</span> <span style="color:${C.w}">uomp revoke 7f3a</span><br><span style="color:${C.gn}">\u2713 ${zh ? '下一个请求' : 'next request'} \u2192 403</span><br>`,
  ];
  let i = 0, cycle = 0, timer;
  const maxCycles = 3;

  function scroll() { el.scrollTop = el.scrollHeight; }

  function next() {
    if (document.hidden) { timer = setTimeout(next, 1000); return; }
    el.innerHTML += frames[i]; scroll(); i++;
    if (i >= frames.length) { i = 0; cycle++; }
    if (cycle >= maxCycles) {
      el.innerHTML = ''; cycle = 0;
      timer = setTimeout(next, 2000); return;
    }
    timer = setTimeout(next, 1800);
  }

  el.innerHTML = `<span style="color:${C.dim}">UOMP</span><br><br>`;
  timer = setTimeout(next, 800);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) scroll(); });
  window.addEventListener('beforeunload', () => clearTimeout(timer));
})();
</script>
<style>
  #terminal-demo::-webkit-scrollbar { width: 4px; }
  #terminal-demo::-webkit-scrollbar-track { background: #111; }
  #terminal-demo::-webkit-scrollbar-thumb { background: #333; }
  @media (prefers-reduced-motion: reduce) {
    .window-body * { animation: none !important; }
  }
</style>
